{
    "name": "min-gruvbox-theme",
    "displayName": "Min Gruvbox Theme",
    "description": "A minimalistic and warm theme.",
    "publisher": "cnmorocho",
    "author": {
        "name": "Carlos Nahuel Morocho"
    },
    "homepage": "https://github.com/cnmorocho/min-gruvbox-theme.git",
    "repository": {
        "type": "git",
        "url": "https://github.com/cnmorocho/min-gruvbox-theme.git"
    },
    "icon": "min-gruvbox-icon.png",
    "version": "0.0.10",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Themes"
    ],
    "scripts": {
        "format": "prettier --write **/*.json"
    },
    "contributes": {
        "themes": [
